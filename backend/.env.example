# StudyHub Backend Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Database (SQLite default for local development, PostgreSQL asyncpg for production)
DATABASE_URL=sqlite+aiosqlite:///./pathward.db

# Frontend Application URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Groq LLM Provider (for AI code explanations, resume ATS analysis, and placement copilot)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# Supabase (Optional: for cloud authentication and storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
